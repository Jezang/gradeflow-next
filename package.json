{
  "name": "gradeflow-next",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --test tests/firestore.test.mjs",
    "test:ranking": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/ranking.test.mjs",
    "test:reports": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/reports.test.mjs",
    "test:migration": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/migration.test.mjs",
    "test:backup": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/backup.test.mjs",
    "test:portal": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/portal.test.mjs",
    "test:line": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/line.test.mjs",
    "test:recovery": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/recovery.test.mjs",
    "rehearse:recovery": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/recovery-emulator.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "firebase": "^12.0.0",
    "@zxing/browser": "^0.1.5",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.12.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.5"
  }
}