rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function own(uid){return signed() && request.auth.uid == uid;}
  function profile(){return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;}
  function owner(){return signed() && profile().active == true && profile().role == 'super_admin';}
  function admin(){return signed() && profile().active == true && profile().role in ['super_admin','admin'];}
  match /profiles/{uid} {
   allow get: if own(uid) || owner();
   allow create: if owner() && request.resource.data.keys().hasOnly(['role','active','name','email'])
     && request.resource.data.role == 'teacher' && request.resource.data.active == true
     && get(/databases/$(database)/documents/teacherRequests/$(uid)).data.status == 'pending'
     && getAfter(/databases/$(database)/documents/teacherRequests/$(uid)).data.status == 'approved'
     && request.resource.data.name == get(/databases/$(database)/documents/teacherRequests/$(uid)).data.name
     && request.resource.data.email == get(/databases/$(database)/documents/teacherRequests/$(uid)).data.email;
   allow list: if owner();
   allow update: if own(uid) && resource.data.active == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
   allow update: if owner() && resource.data.role == 'teacher' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active is bool;
   allow delete: if false;
  }
  match /teacherRequests/{uid} {
   allow get: if own(uid) || owner();
   allow list: if owner();
   allow create: if own(uid) && request.auth.token.email_verified == true
     && !exists(/databases/$(database)/documents/profiles/$(uid))
     && request.resource.data.keys().hasOnly(['name','email','status','createdAt'])
     && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
     && request.resource.data.email == request.auth.token.email
     && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
   allow update: if owner() && resource.data.status == 'pending'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
     && request.resource.data.reviewedAt == request.time
     && (request.resource.data.status == 'rejected' || (request.resource.data.status == 'approved'
     && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.role == 'teacher'
     && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.active == true));
   allow delete: if false;
  }
  function activeRecord(kind,id){return id is string && id.size() > 0 && get(/databases/$(database)/documents/$(kind)/$(id)).data.active == true;}
  // Advisor rights are explicitly assigned by the owner for a single room.
  function advisorForRoom(roomId){return staff() && roomId is string
    && get(/databases/$(database)/documents/advisorAssignments/$(request.auth.uid)/rooms/$(roomId)).data.active == true
    && activeRecord('rooms',roomId);}
  function advisorCourse(cid){return course(cid).active == true && advisorForRoom(course(cid).roomId);}
  match /advisorAssignments/{uid}/rooms/{roomId} {
   allow read: if owner() || (own(uid) && staff());
   allow create, update: if owner() && activeRecord('profiles',uid)
     && get(/databases/$(database)/documents/profiles/$(uid)).data.role == 'teacher'
     && activeRecord('rooms',roomId)
     && request.resource.data.keys().hasOnly(['roomId','active','updatedBy','updatedAt'])
     && request.resource.data.roomId == roomId && request.resource.data.active is bool
     && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
   allow delete: if owner();
  }
  match /teachingAssignments/{id} {
   allow read: if admin() || (signed() && profile().active == true && profile().role == 'teacher' && resource.data.teacherUid == request.auth.uid) || (resource.data.active == true && advisorForRoom(resource.data.roomId));
   allow create: if admin() && request.resource.data.keys().hasOnly(['teacherUid','roomId','subjectId','termId','active','createdAt'])
     && request.resource.data.teacherUid is string && (get(/databases/$(database)/documents/profiles/$(request.resource.data.teacherUid)).data.role == 'teacher' || ((owner() || request.resource.data.teacherUid == request.auth.uid) && get(/databases/$(database)/documents/profiles/$(request.resource.data.teacherUid)).data.role in ['admin','super_admin']))
     && activeRecord('profiles',request.resource.data.teacherUid) && activeRecord('rooms',request.resource.data.roomId)
     && activeRecord('subjects',request.resource.data.subjectId) && activeRecord('terms',request.resource.data.termId)
     && id == request.resource.data.teacherUid + '__' + request.resource.data.roomId + '__' + request.resource.data.subjectId + '__' + request.resource.data.termId
     && request.resource.data.active == true && request.resource.data.createdAt == request.time;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active == false;
   allow delete: if false;
  }
  function course(id){return get(/databases/$(database)/documents/teachingAssignments/$(id)).data;}
  function staff(){return signed() && profile().active == true && profile().role in ['teacher','admin','super_admin'];}
  function canCourse(id){return staff() && (admin() || course(id).teacherUid == request.auth.uid);}
  function openCourse(id){return canCourse(id) && course(id).active == true && activeRecord('profiles',course(id).teacherUid);}
  function enrolled(cid,sid){return get(/databases/$(database)/documents/teachingAssignments/$(cid)/roster/$(sid)).data.active == true;}
  match /teachingAssignments/{cid}/roster/{sid} {
   allow read: if canCourse(cid) || advisorCourse(cid);
   allow create, update: if admin() && course(cid).active == true
     && request.resource.data.keys().hasOnly(['studentId','name','active'])
     && request.resource.data.studentId == sid && request.resource.data.active is bool
     && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
     && request.resource.data.name == get(/databases/$(database)/documents/students/$(sid)).data.name
     && (request.resource.data.active == false || activeRecord('students',sid));
   allow delete: if false;
  }
  match /teachingAssignments/{cid}/work/{wid} {
   allow read: if canCourse(cid) || advisorCourse(cid);
   allow create: if openCourse(cid) && request.resource.data.keys().hasOnly(['title','maxScore','createdBy','createdAt','active'])
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
     && request.resource.data.maxScore is number && request.resource.data.maxScore > 0 && request.resource.data.maxScore <= 1000
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.active == true;
   function archiveHeader(aid){return get(/databases/$(database)/documents/legacyArchives/$(cid)/assignments/$(aid)).data;}
   allow create: if owner() && openCourse(cid)
     && request.resource.data.keys().hasOnly(['title','maxScore','createdBy','createdAt','active','legacyId','legacyDue','importPending'])
     && request.resource.data.legacyId is string && wid == 'legacy_' + request.resource.data.legacyId
     && request.resource.data.title == archiveHeader(request.resource.data.legacyId).title
     && request.resource.data.maxScore == archiveHeader(request.resource.data.legacyId).maxScore
     && request.resource.data.legacyDue == archiveHeader(request.resource.data.legacyId).due
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
     && request.resource.data.active == false && request.resource.data.importPending == true;
   allow update: if owner() && openCourse(cid) && resource.data.get('importPending',false) == true
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','importPending'])
     && request.resource.data.active == true && request.resource.data.importPending == false;
   allow update: if openCourse(cid) && resource.data.get('importPending',false) == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active == false;
   allow delete: if false;
   // Deadlines are informational: late work and audited corrections remain possible.
   allow update: if openCourse(cid) && resource.data.active == true
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deadline','revisionDeadline','deadlineUpdatedBy','deadlineUpdatedAt'])
     && request.resource.data.keys().hasAll(['deadline','revisionDeadline','deadlineUpdatedBy','deadlineUpdatedAt'])
     && (request.resource.data.deadline == null || request.resource.data.deadline is timestamp)
     && (request.resource.data.revisionDeadline == null || (request.resource.data.deadline is timestamp && request.resource.data.revisionDeadline is timestamp && request.resource.data.revisionDeadline >= request.resource.data.deadline))
     && request.resource.data.deadlineUpdatedBy == request.auth.uid && request.resource.data.deadlineUpdatedAt == request.time;
   match /attendance/{sid} {
    function submissionPath(){return /databases/$(database)/documents/teachingAssignments/$(cid)/work/$(wid)/submissions/$(sid);}
    allow read: if canCourse(cid) || advisorCourse(cid);
    allow create, update: if openCourse(cid) && enrolled(cid,sid)
      && get(/databases/$(database)/documents/teachingAssignments/$(cid)/work/$(wid)).data.active == true
      && (!exists(submissionPath()) || getAfter(submissionPath()).data.submitted == false)
      && request.resource.data.keys().hasOnly(['studentId','status','updatedBy','updatedAt'])
      && request.resource.data.studentId == sid && request.resource.data.status in ['leave','absent','missing']
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    allow delete: if false;
   }
   match /submissions/{sid} {
    function work(){return get(/databases/$(database)/documents/teachingAssignments/$(cid)/work/$(wid)).data;}
    allow read: if canCourse(cid) || advisorCourse(cid);
    function validResult(){return openCourse(cid) && work().active == true && enrolled(cid,sid)
      && request.resource.data.studentId == sid && request.resource.data.submitted is bool
      && (request.resource.data.submitted == true || request.resource.data.score == null)
      && (request.resource.data.score == null || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= work().maxScore))
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;}
    function auditPath(){return /databases/$(database)/documents/teachingAssignments/$(cid)/work/$(wid)/submissions/$(sid)/history/$(request.resource.data.auditId);}
    allow create: if validResult() && request.resource.data.submitted == true && request.resource.data.keys().hasOnly(['studentId','score','submitted','updatedBy','updatedAt']);
    function archivedRow(){return get(/databases/$(database)/documents/legacyArchives/$(cid)/assignments/$(work().legacyId)/students/$(sid)).data;}
    allow create: if owner() && openCourse(cid) && work().get('importPending',false) == true && work().active == false && enrolled(cid,sid)
      && request.resource.data.keys().hasOnly(['studentId','score','submitted','updatedBy','updatedAt','legacy'])
      && archivedRow().record != null && request.resource.data.legacy == archivedRow().record
      && request.resource.data.studentId == sid && request.resource.data.score == archivedRow().record.score
      && request.resource.data.submitted == archivedRow().record.submitted
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    allow update: if validResult() && request.resource.data.keys().hasOnly(['studentId','score','submitted','updatedBy','updatedAt','auditId','legacy'])
      && request.resource.data.get('legacy',null) == resource.data.get('legacy',null)
      && request.resource.data.auditId is string && !exists(auditPath())
      && getAfter(auditPath()).data.beforeScore == resource.data.score
      && getAfter(auditPath()).data.beforeSubmitted == resource.data.submitted
      && getAfter(auditPath()).data.afterScore == request.resource.data.score
      && getAfter(auditPath()).data.afterSubmitted == request.resource.data.submitted
      && getAfter(auditPath()).data.actor == request.auth.uid && getAfter(auditPath()).data.at == request.time;
    match /history/{hid} {
     function submission(){return /databases/$(database)/documents/teachingAssignments/$(cid)/work/$(wid)/submissions/$(sid);}
     allow read: if canCourse(cid);
     allow create: if openCourse(cid) && exists(submission())
       && request.resource.data.keys().hasOnly(['beforeScore','beforeSubmitted','afterScore','afterSubmitted','actor','at'])
       && request.resource.data.beforeScore == get(submission()).data.score && request.resource.data.beforeSubmitted == get(submission()).data.submitted
       && request.resource.data.afterScore == getAfter(submission()).data.score && request.resource.data.afterSubmitted == getAfter(submission()).data.submitted
       && getAfter(submission()).data.auditId == hid && getAfter(submission()).data.updatedAt == request.time
       && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time;
     allow update, delete: if false;
    }
    allow delete: if false;
   }
  }

  // Historical snapshots remain separate from live grading, owner only.
  match /legacyArchives/{cid}/assignments/{aid} {
   allow read: if owner();
   allow create: if owner() && openCourse(cid)
     && aid.matches('^[A-Za-z0-9_-]{1,100}$')
     && request.resource.data.keys().hasOnly(['title','maxScore','due','level','room','subject','studentCount','recordCount','createdBy','createdAt'])
     && request.resource.data.keys().hasAll(['title','maxScore','due','level','room','subject','studentCount','recordCount','createdBy','createdAt'])
     && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
     && request.resource.data.maxScore is number && request.resource.data.maxScore > 0 && request.resource.data.maxScore <= 1000
     && request.resource.data.due is string && request.resource.data.due.size() <= 100
     && request.resource.data.level is string && request.resource.data.level.size() <= 100
     && request.resource.data.room is string && request.resource.data.room.size() <= 100
     && request.resource.data.subject is string && request.resource.data.subject.size() <= 160
     && request.resource.data.studentCount is int && request.resource.data.studentCount > 0 && request.resource.data.studentCount <= 500
     && request.resource.data.recordCount is int && request.resource.data.recordCount >= 0 && request.resource.data.recordCount <= request.resource.data.studentCount
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
   match /students/{sid} {
    function header(){return getAfter(/databases/$(database)/documents/legacyArchives/$(cid)/assignments/$(aid)).data;}
    allow read: if owner();
    allow create: if owner() && openCourse(cid) && enrolled(cid,sid)
      && request.resource.data.keys().hasOnly(['name','level','room','subject','no','record'])
      && request.resource.data.name == get(/databases/$(database)/documents/teachingAssignments/$(cid)/roster/$(sid)).data.name
      && request.resource.data.level is string && request.resource.data.level.size() <= 100
      && request.resource.data.room is string && request.resource.data.room.size() <= 100
      && request.resource.data.subject is string && request.resource.data.subject.size() <= 160
      && request.resource.data.no is string && request.resource.data.no.size() <= 100
      && header().createdBy == request.auth.uid
      && (request.resource.data.record == null || validLegacy(request.resource.data.record));
    function validLegacy(rec){return rec is map
      && rec.keys().hasOnly(['studentId','submitted','score','status','note','originalTs'])
      && rec.studentId == sid && rec.submitted is bool
      && ((rec.submitted == true && rec.status == 'submitted') || (rec.submitted == false && rec.status in ['missing','leave','absent'] && rec.score == null))
      && (rec.score == null || (rec.score is number && rec.score >= 0 && rec.score <= header().maxScore))
      && rec.note is string && rec.note.size() <= 2000
      && (rec.originalTs == null || (rec.originalTs is int && rec.originalTs >= 0));}
    allow update, delete: if false;
   }
  }
  // One send attempt per account per server-time 30-second bucket.
  match /lineRate/{uid}/slots/{slot} {
   allow create: if own(uid) && staff()
     && request.resource.data.keys().hasOnly(['uid','bucket'])
     && request.resource.data.uid == uid && request.resource.data.bucket is int
     && slot == string(request.resource.data.bucket)
     && request.resource.data.bucket * 30000 <= request.time.toMillis()
     && request.time.toMillis() < (request.resource.data.bucket + 1) * 30000;
   allow read, update, delete: if false;
  }
  match /{kind}/{id} {
   allow read: if kind in ['students','rooms','subjects','terms'] && admin();
   allow create: if kind in ['students','rooms','subjects','terms'] && admin()
     && id.matches('^[A-Za-z0-9_-]{1,60}$')
     && request.resource.data.keys().hasOnly(['code','name','active','createdAt'])
     && request.resource.data.code == id && request.resource.data.name is string
     && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
     && request.resource.data.active == true && request.resource.data.createdAt == request.time;
   allow update: if kind in ['students','rooms','subjects','terms'] && admin()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','name'])
     && request.resource.data.active is bool && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160;
   allow delete: if false;
  }
 }
}
