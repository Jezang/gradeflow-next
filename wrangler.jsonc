{
  "name": "gradeflow-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gradeflow-next"
    }
  ],
  "keep_vars": true
}